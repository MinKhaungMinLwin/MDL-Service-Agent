# Copy this file to `.env` and fill in local secrets before running scripts.

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://dse-bluedragon-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.2

# Embeddings
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=2048
EMBEDDING_BATCH_MAX_CHARS=60000
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=50
